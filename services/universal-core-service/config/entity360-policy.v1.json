  "budgets": {
    "max_sources": 11,
    "max_entities": 256,
    "max_evidence": 512,
    "max_relationship_depth": 4,
    "max_retrieval_bytes": 1048576,
    "max_context_tokens": 131072,
    "per_source": {
      "default": {
        "max_contributions": 64,
        "max_evidence": 128,
        "max_bytes": 262144,
        "max_tokens": 32768
      },
      "shared_memory": {
        "max_contributions": 16,
        "max_evidence": 32,
        "max_bytes": 65536,
        "max_tokens": 8192
      }
    },
    "per_source_class": {
      "default": {
        "max_contributions": 128,
        "max_evidence": 256,
        "max_bytes": 524288,
        "max_tokens": 65536
      },
      "memory": {
        "max_contributions": 16,
        "max_evidence": 32,
        "max_bytes": 65536,
        "max_tokens": 8192
      }
    },
    "per_trust_class": {
      "default": {
        "max_contributions": 128,
        "max_evidence": 256,
        "max_bytes": 524288,
        "max_tokens": 65536
      },
      "advisory": {
        "max_contributions": 16,
        "max_evidence": 32,
        "max_bytes": 65536,
        "max_tokens": 8192
      }
    }
  },
  "freshness": {
    "default_max_age_seconds": 86400,
    "max_clock_skew_seconds": 300,
    "by_source_class": {
      "architecture": 86400,
      "continuity": 3600,
      "event_ledger": 3600,
      "governance": 86400,
      "memory": 21600,
      "runtime": 900,
      "security": 3600
    }
  },
  "corroboration": {
    "default_min_independent_sources": 1,
    "high_impact_min_independent_sources": 2,
    "high_impact_eligible_trust_classes": [
      "core_verified",
      "tenant_verified",
      "provider_verified"
    ],
    "allow_verified_authoritative": true
  },
  "shadow_observation": {
    "schema_version": "entity_360_shadow_observation_policy_v1",
    "minimum_interval_ms": 30000,
    "max_inflight_global": 4,
    "max_inflight_per_tenant": 2,
    "window_ms": 60000,
    "max_starts_per_window": 60,
    "max_starts_per_tenant_window": 30,
    "max_tracked_work_keys": 4096,
    "max_tracked_tenants": 1024,
    "max_gate_inflight_global": 16,
    "max_cached_tenant_gates": 1024,
    "tenant_off_gate_cache_ttl_ms": 5000,
    "gate_timeout_ms": 5000
  },
  "temporal_reconciliation": {
    "schema_version": "entity_360_temporal_reconciliation_policy_v1",
    "authority_transitions": []
  },
